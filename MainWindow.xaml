<Window x:Class="CatchLog.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CatchLog - Horgásznapló Rendszer" Height="550" Width="920" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#1E293B">
            <TextBlock Text="CATCHLOG" Foreground="White" FontSize="20" FontWeight="Bold" Margin="20,25,20,5"/>

            <Button Content="Fogások" Click="OpenCatches_Click" Background="Transparent" Foreground="White" FontSize="15" HorizontalContentAlignment="Left" Padding="20,12" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Horgászok" Click="OpenAnglers_Click" Background="Transparent" Foreground="White" FontSize="15" HorizontalContentAlignment="Left" Padding="20,12" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Horgászhelyek" Click="OpenSpots_Click" Background="Transparent" Foreground="White" FontSize="15" HorizontalContentAlignment="Left" Padding="20,12" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <!-- Aktív nézet helye -->
        <ContentControl x:Name="MainContent" Grid.Column="1"/>
    </Grid>
</Window>